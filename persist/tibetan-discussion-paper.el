;;; tibetan-discussion-paper.el --- Discussion paper for the reMarkable -*- lexical-binding: t -*-

;;; Commentary:
;; §5.64 (2026-10-20): in the reading classes the text is open in the
;; CAT tool; next to it, on the reMarkable, Carsten wants a DISCUSSION
;; PAPER — not the look-up handout (§5.59, vocabulary and grammar are
;; on screen) but, per sentence: the Uchen/Wylie line and the tool's
;; translation as anchor, the Concept Notes, the Sanskrit comparison
;; (bilingual texts, `tibetan-sanskrit-comparison') and the seminar
;; discussion (§5.62).  reMarkable page format (A5 ≈ the 10.3"
;; screen, narrow margins, 9 pt) so that a sentence fits a page
;; where it can; after the LuaLaTeX export the PDF is uploaded with
;; rmapi into a folder on the device (C-c u D).
;;
;; Layering as in the handout: DATA (`--sentence-data', reads the
;; cascade sentence files), RENDERER (pure: spec → org), COMMAND
;; (scope at point → .org → PDF → upload).  Shared with the handout:
;; the segment list, the translation reader, the markdown→org
;; converter, the LaTeX macros, the discussion block, the PDF export
;; and the output-file naming (KIND \"disk\").  Provided translations
;; are quoted by the discussion, never reproduced; the word Claude
;; never appears.

;;; Code:

(require 'cl-lib)
(require 'tibetan-handout)
(require 'tibetan-translation-discussion)
(require 'tibetan-sanskrit-comparison)
(require 'tibetan-cascade)
(require 'ucs-normalize)

(declare-function tibetan-sentence--filepath "tibetan-sentence-persist")
(declare-function tibetan-cascade--scope-at-point "tibetan-cascade")

(defconst tibetan-discussion-paper-generated-marker
  "# GENERATED by tibetan-discussion-paper"
  "First line of every generated discussion paper (overwrite guard as
for the handout; C-c u D inside a generated paper exports it as it is).")

(defcustom tibetan-discussion-paper-remarkable-folder "Reading"
  "Folder on the reMarkable (rmapi path without leading slash) that
receives the exported discussion papers."
  :type 'string
  :group 'tibetan-cat)

(defcustom tibetan-discussion-paper-upload t
  "When non-nil, C-c u D uploads the exported PDF to the reMarkable
with rmapi (`tibetan-discussion-paper-remarkable-folder')."
  :type 'boolean
  :group 'tibetan-cat)

;; ============================================================================
;; Data
;; ============================================================================

(defun tibetan-discussion-paper--sentence-data (sent-num source-file)
  "Everything the paper needs for sentence SENT-NUM of SOURCE-FILE.
Plist: :sent-num :lang :segs (`tibetan-handout--seg-list') and, when
the cascade file exists, :translation (`tibetan-handout--translation'),
:concepts (the Concept Notes as plain text, nil when still a
placeholder), :discussion (`tibetan-discussion-read') and :comparison
\(`tibetan-sanskrit-comparison-read'); otherwise :missing t."
  (let* ((lang (tibetan-analysis--resolve-source-lang source-file))
         (sa (equal lang "sa"))
         (segs (tibetan-cascade--segs-for-sentence source-file sent-num))
         (folder (file-name-as-directory
                  (expand-file-name "analysis"
                                    (file-name-directory source-file))))
         (file (tibetan-sentence--filepath sent-num folder source-file))
         (base (list :sent-num sent-num :lang lang
                     :segs (tibetan-handout--seg-list segs sa))))
    (if (not (file-exists-p file))
        (append base (list :missing t))
      (let ((sections (tibetan-analysis--read-claude-sections file)))
        (append base
                (list :translation (tibetan-handout--translation
                                    file (mapcar #'car segs) sections)
                      :concepts (tibetan-cascade--clean-slot-text
                                 (plist-get sections :concepts))
                      :discussion (tibetan-discussion-read file)
                      :comparison (tibetan-sanskrit-comparison-read file)))))))

;; ============================================================================
;; Renderer (pure: spec → org string)
;; ============================================================================

(defun tibetan-discussion-paper--header (spec)
  "The org header of SPEC: reMarkable page (A5, 7 mm margins, 9 pt),
a one-line running head, the shared LaTeX macros."
  (let* ((title (plist-get spec :title))
         (scope (plist-get spec :scope))
         (range (tibetan-handout--sentence-range (plist-get spec :sentences)))
         (head (mapconcat #'tibetan-handout--latex-escape
                          (delete-dups (delq nil (list scope range)))
                          " · ")))
    (concat
     tibetan-discussion-paper-generated-marker
     " — darf gekürzt werden; C-c u D erzeugt neu\n"
     (format "# Quelle: %s · %s · generiert %s\n"
             (plist-get spec :source-name) scope (plist-get spec :date))
     (format "#+TITLE: %s — %s\n" title scope)
     "#+LANGUAGE: de\n"
     "#+OPTIONS: toc:nil num:nil title:nil author:nil date:nil ^:nil\n"
     "#+LATEX_COMPILER: lualatex\n"
     "#+LATEX_CLASS: article\n"
     "#+LATEX_CLASS_OPTIONS: [9pt,a5paper]\n"
     ;; A5 (148 × 210 mm) is the reMarkable 2 screen (157.8 × 210.4 mm)
     ;; to within a centimetre — the page fills the display unscaled.
     "#+LATEX_HEADER: \\usepackage[a5paper,left=7mm,right=7mm,top=9mm,bottom=7mm,headsep=3mm,footskip=4mm]{geometry}\n"
     "#+LATEX_HEADER: \\usepackage{fontspec}\n"
     "#+LATEX_HEADER: \\usepackage{libertinus}\n"
     (format "#+LATEX_HEADER: \\newfontfamily\\tibfont{%s}[Renderer=HarfBuzz,Script=Tibetan]\n"
             tibetan-handout-tibetan-font)
     "#+LATEX_HEADER: \\usepackage{xcolor,fancyhdr,needspace,newunicodechar,enumitem,titlesec}\n"
     "#+LATEX_HEADER: \\newunicodechar{★}{\\ensuremath{\\star}}\n"
     "#+LATEX_HEADER: \\definecolor{seg}{rgb}{0.55,0.10,0.10}\\definecolor{dim}{gray}{0.40}\n"
     "#+LATEX_HEADER: \\pagestyle{fancy}\\fancyhf{}\\renewcommand{\\headrulewidth}{0.3pt}\n"
     (format "#+LATEX_HEADER: \\fancyhead[L]{\\scriptsize\\textit{%s} · %s}\\fancyhead[R]{\\scriptsize\\thepage}\n"
             (tibetan-handout--latex-escape title) head)
     (format "#+LATEX_HEADER: \\fancyfoot[L]{\\tiny\\color{dim}Stand %s}\n"
             (plist-get spec :date))
     "#+LATEX_HEADER: \\setlength{\\parindent}{0pt}\\setlength{\\parskip}{0.3ex}\n"
     "#+LATEX_HEADER: \\titleformat{\\section}{\\Needspace{5\\baselineskip}\\normalsize\\bfseries}{}{0pt}{}\n"
     "#+LATEX_HEADER: \\titleformat{\\subsection}{\\Needspace{3\\baselineskip}\\small\\bfseries\\color{seg}}{}{0pt}{}\n"
     "#+LATEX_HEADER: \\titlespacing*{\\section}{0pt}{1.6ex plus .4ex}{.4ex}\\titlespacing*{\\subsection}{0pt}{1ex plus .3ex}{.2ex}\n"
     "#+LATEX_HEADER: \\setlist[description]{font=\\normalfont\\scshape\\color{seg}\\scriptsize,leftmargin=0pt,labelsep=0.4em,itemsep=0pt,topsep=1pt,parsep=0pt}\n"
     "#+LATEX_HEADER: \\setlist[itemize]{leftmargin=1em,itemsep=0pt,topsep=1pt,parsep=0pt}\n"
     "#+LATEX_HEADER: \\newcommand{\\rubrik}[1]{{\\scriptsize\\scshape\\color{seg}#1}\\enspace}\n"
     tibetan-handout--latex-commands
     "#+MACRO: rubrik @@latex:\\rubrik{$1}@@\n"
     "\n")))

(defun tibetan-discussion-paper--comparison-block (comp)
  "`** Sanskrit-Vergleich' for COMP (`tibetan-sanskrit-comparison-read'),
\"\" when nil: correspondence, per point a bold title and the
Tibetisch / Sanskrit / Abweichung / Bedeutung lines, the assessment."
  (if (null comp)
      ""
    (concat
     "** Sanskrit-Vergleich\n"
     (let ((c (plist-get comp :correspondence)))
       (if (and c (not (string-empty-p c)))
           (concat (tibetan-handout--md-to-org c) "\n\n")
         ""))
     (cl-loop
      for p in (plist-get comp :points) for i from 1
      concat
      (concat
       (format "*%d. %s*\n" i (plist-get p :title))
       (mapconcat (lambda (it)
                    (format "- %s :: %s"
                            (tibetan-sanskrit-comparison--label (car it) "de")
                            (tibetan-handout--md-to-org (cdr it))))
                  (plist-get p :items) "\n")
       "\n\n"))
     (let ((a (plist-get comp :assessment)))
       (if (and a (not (string-empty-p a)))
           (concat "{{{rubrik(Einschätzung)}}}" (tibetan-handout--md-to-org a) "\n\n")
         "")))))

(defun tibetan-discussion-paper--sentence-block (d)
  "`* Satz N (Seg. …)' for the sentence data D: the Uchen/Wylie line,
the Übersetzung, `** Begriffe', `** Sanskrit-Vergleich' (only when
one exists), `** Diskussion' — or the visible gap."
  (let* ((segs (plist-get d :segs))
         (tr (plist-get d :translation)))
    (concat
     (format "* Satz %d (Seg. %s)\n" (plist-get d :sent-num)
             (tibetan-handout--seg-range segs))
     "#+BEGIN_EXPORT latex\n"
     (mapconcat
      (lambda (s)
        (let ((num (plist-get s :num))
              (wylie (tibetan-handout--latex-escape (plist-get s :wylie)))
              (uchen (plist-get s :uchen)))
          (if uchen
              (format "\\segsup{%d}{\\tibfont %s}\\par\\noindent{\\small\\itshape %s}\\par\n"
                      num (tibetan-handout--latex-escape uchen) wylie)
            (format "\\segsup{%d}{\\small\\itshape %s}\\par\n" num wylie))))
      segs "")
     "\\smallskip\n#+END_EXPORT\n\n"
     (if (plist-get d :missing)
         "{{{luecke(Analysedatei fehlt — C-c u A auf dem Satz)}}}\n\n"
       (concat
        "{{{rubrik(Übersetzung)}}}"
        (cond
         ((plist-get tr :by-seg)
          (concat (mapconcat (lambda (p)
                               (format "{{{n(%d)}}}%s" (car p)
                                       (tibetan-handout--md-to-org (cdr p))))
                             (plist-get tr :by-seg) " ")
                  "\n\n"))
         ((plist-get tr :whole)
          (concat (replace-regexp-in-string
                   "\n" " \\\\\\\\\n"
                   (tibetan-handout--md-to-org (plist-get tr :whole)))
                  "\n\n"))
         (t "{{{luecke(noch nicht übersetzt)}}}\n\n"))
        "** Begriffe\n"
        (if (plist-get d :concepts)
            (concat (tibetan-handout--md-to-org (plist-get d :concepts)) "\n\n")
          "{{{luecke(noch keine Begriffe — C-c u G)}}}\n\n")
        (tibetan-discussion-paper--comparison-block (plist-get d :comparison))
        (if (plist-get d :discussion)
            (tibetan-handout--discussion-block (plist-get d :discussion))
          "** Diskussion\n{{{luecke(noch keine Diskussion — C-c u G / C-c u c)}}}\n\n"))))))

(defun tibetan-discussion-paper-render (spec)
  "The discussion paper org text for SPEC — a plist (:title :scope
:source-name :date :sentences), :sentences being
`tibetan-discussion-paper--sentence-data' plists.  Pure: no file
access.  No `* Text' part (the text is on screen in the CAT tool);
per sentence `* Satz N' with the Uchen/Wylie line, Übersetzung,
Begriffe, Sanskrit-Vergleich, Diskussion."
  (concat (tibetan-discussion-paper--header spec)
          (mapconcat #'tibetan-discussion-paper--sentence-block
                     (plist-get spec :sentences) "")))

;; ============================================================================
;; File, PDF, upload, command
;; ============================================================================

(defun tibetan-discussion-paper--output-file (scope)
  "`<source dir>/handouts/<short>-disk-par-NNN.org' /
`<short>-disk-sent-N[-M].org' for SCOPE."
  (tibetan-handout--output-file scope "disk"))

(defun tibetan-discussion-paper--render-scope (scope date)
  "The paper org text for SCOPE dated DATE."
  (let ((src (plist-get scope :source)))
    (tibetan-discussion-paper-render
     (list :title (tibetan-handout--source-title src)
           :scope (plist-get scope :label)
           :source-name (file-name-nondirectory src)
           :date date
           :sentences (mapcar (lambda (n)
                                (tibetan-discussion-paper--sentence-data n src))
                              (plist-get scope :sent-nums))))))

(defun tibetan-discussion-paper--guard-target (out)
  "Signal a user-error when OUT exists without the GENERATED marker."
  (when (and (file-exists-p out)
             (not (with-temp-buffer
                    (insert-file-contents out nil 0 512)
                    (string-prefix-p tibetan-discussion-paper-generated-marker
                                     (buffer-string)))))
    (user-error "%s existiert und trägt keinen GENERATED-Marker — nicht überschrieben"
                (file-name-nondirectory out))))

(defun tibetan-discussion-paper--content-key (text)
  "TEXT without the lines that change with every build (date/footer)."
  (replace-regexp-in-string
   "^\\(?:# Quelle:.*\\|#\\+LATEX_HEADER: \\\\fancyfoot.*\\)\n" "" text))

(defun tibetan-discussion-paper--unchanged-p (out text)
  "Non-nil when the generated paper OUT already holds TEXT (dates aside)."
  (and (file-exists-p out)
       (equal (tibetan-discussion-paper--content-key text)
              (tibetan-discussion-paper--content-key
               (with-temp-buffer (insert-file-contents out) (buffer-string))))))

(defun tibetan-discussion-paper-build (scope &optional date)
  "Write the discussion paper .org for SCOPE (`tibetan-cascade--scope-
at-point' shape) and return its path; DATE (default today) goes into
the footer.  An existing target WITHOUT the GENERATED marker is never
overwritten (user-error)."
  (let ((out (tibetan-discussion-paper--output-file scope)))
    (tibetan-discussion-paper--guard-target out)
    (make-directory (file-name-directory out) t)
    (with-temp-file out
      (insert (tibetan-discussion-paper--render-scope
               scope (or date (format-time-string "%Y-%m-%d")))))
    out))

(defvar tibetan-discussion-paper--rmapi-queue nil
  "Pending rmapi sessions, oldest first: ((COMMANDS . CALLBACK) …).")

(defvar tibetan-discussion-paper--rmapi-running nil
  "Non-nil while an rmapi session runs.")

(defun tibetan-discussion-paper--rmapi-quote (arg)
  "ARG quoted for the rmapi shell (double quotes, inner quotes escaped)."
  (if (string-match-p "[ \t\"'()]" arg)
      (concat "\"" (replace-regexp-in-string "\"" "\\\\\"" arg) "\"")
    arg))

(defun tibetan-discussion-paper--rmapi-script (commands)
  "The stdin script of an rmapi shell session running COMMANDS (lists
of args), ending with exit."
  (concat (mapconcat (lambda (c)
                       (mapconcat #'tibetan-discussion-paper--rmapi-quote c " "))
                     commands "\n")
          "\nexit\n"))

(defun tibetan-discussion-paper--rmapi-session-start (commands done)
  "Start ONE rmapi shell process, feed it COMMANDS (lists of args) on
stdin; DONE gets (EXIT-CODE OUTPUT).  One process = one cloud token:
the token endpoint is rate-limited (429 after a handful of separate
invocations, 20.10.2026), so every command of an upload rides one
session."
  (let* ((buf (generate-new-buffer " *rmapi*"))
         (proc (make-process :name "rmapi" :buffer buf
                             :command (list "rmapi")
                             :noquery t
                             :connection-type 'pipe
                             :sentinel
                             (lambda (p _event)
                               (unless (process-live-p p)
                                 (let ((out (with-current-buffer buf (buffer-string))))
                                   (kill-buffer buf)
                                   (funcall done (process-exit-status p) out)))))))
    (process-send-string proc (tibetan-discussion-paper--rmapi-script commands))
    (process-send-eof proc)
    proc))

(defun tibetan-discussion-paper--rmapi-next ()
  "Start the next queued rmapi session unless one is running."
  (unless tibetan-discussion-paper--rmapi-running
    (let ((job (pop tibetan-discussion-paper--rmapi-queue)))
      (when job
        (setq tibetan-discussion-paper--rmapi-running t)
        (condition-case err
            (tibetan-discussion-paper--rmapi-session-start
             (car job)
             (lambda (code out)
               (setq tibetan-discussion-paper--rmapi-running nil)
               (unwind-protect
                   (condition-case e
                       (funcall (cdr job) code out)
                     (error (message "rmapi callback failed: %s"
                                     (error-message-string e))))
                 (tibetan-discussion-paper--rmapi-next))))
          (error
           (setq tibetan-discussion-paper--rmapi-running nil)
           (funcall (cdr job) 1 (error-message-string err))
           (tibetan-discussion-paper--rmapi-next)))))))

(defun tibetan-discussion-paper--rmapi-session (commands callback)
  "Queue an rmapi shell session running COMMANDS (lists of args);
CALLBACK gets (EXIT-CODE OUTPUT).  Sessions run ONE at a time, and
all commands of one logical operation share one session — separate
rmapi invocations each fetch a token, and the token endpoint answers
429 after a few of them."
  (setq tibetan-discussion-paper--rmapi-queue
        (append tibetan-discussion-paper--rmapi-queue (list (cons commands callback))))
  (tibetan-discussion-paper--rmapi-next)
  t)

(defun tibetan-discussion-paper--put-result (output docname)
  "What the rmapi shell OUTPUT says about `put' of DOCNAME: `ok' when
it uploaded, `exists' when the name is taken, else `failed'."
  (let ((tail (if (string-match "uploading:" output)
                  (substring output (match-beginning 0))
                output)))
    (cond
     ((string-match-p "already exists" tail) 'exists)
     ((and (string-match-p "uploading:" tail)
           (not (string-match-p "Error\\|failed\\|429" tail)))
      'ok)
     (t (ignore docname) 'failed))))

(defun tibetan-discussion-paper--doc-name (name)
  "NAME as a reMarkable folder/document name: ASCII letters, digits,
space, comma, point and hyphen only.  Umlauts become ae/oe/ue/ss,
diacritics are stripped (ā → a, ñ → n), dashes become \"-\", § becomes
\"Par.\", circled digits their number; apostrophes, brackets and the
rest vanish.  Carsten (20.10.): the folder \"bDen pa gnyis la \\='jug pa
\(Satyadvayāvatāra)\" would not open on the device."
  (let* ((s (string-trim name))
         (s (replace-regexp-in-string "§[ \t]*" "Par. " s))
         (s (replace-regexp-in-string "[–—‐‑−]" "-" s))
         (s (mapconcat (lambda (c)
                         (pcase c
                           (?ä "ae") (?ö "oe") (?ü "ue") (?Ä "Ae") (?Ö "Oe")
                           (?Ü "Ue") (?ß "ss")
                           ((and (guard (<= #x2460 c #x2473)))   ; ① … ⑳ circled
                            (number-to-string (1+ (- c #x2460))))
                           ((and (guard (<= #x2474 c #x2487)))   ; ⑴ parenthesised
                            (number-to-string (1+ (- c #x2474))))
                           (_ (string c))))
                       s ""))
         ;; Strip diacritics: decompose, drop combining marks.
         (s (replace-regexp-in-string "\\(?:[\u0300-\u036f]\\)+" ""
                                      (ucs-normalize-NFKD-string s)))
         (s (replace-regexp-in-string "[^A-Za-z0-9 ,.-]+" " " s))
         (s (replace-regexp-in-string " +" " " s))
         (s (replace-regexp-in-string " ," "," s)))
    (string-trim s)))

(defun tibetan-discussion-paper--upload-commands (folder-base folder tmp)
  "The session commands that create FOLDER-BASE and FOLDER and put TMP."
  (list (list "mkdir" folder-base)
        (list "mkdir" folder)
        (list "put" tmp folder)))

(defun tibetan-discussion-paper--upload (pdf title label)
  "Upload PDF to the reMarkable with rmapi: into the folder
`/<tibetan-discussion-paper-remarkable-folder>/<TITLE>' (one folder
per work, created when missing), as the document LABEL (the
sentence or § — \"Satz 28\", \"Saetze 24-28\"; names ASCII-only,
`--doc-name').  ONE rmapi session does mkdir, mkdir, put.  When a
document of that name already exists there, a second session puts
it with a time stamp appended instead, so notes written on the
earlier one are never overwritten.  Asynchronous; the result is
reported as a message.  Returns non-nil when the upload was started,
nil (with a message) when rmapi is not installed."
  (if (not (executable-find "rmapi"))
      (progn
        (message "rmapi nicht gefunden — PDF liegt unter %s" pdf)
        nil)
    (let* ((base (concat "/" (string-trim tibetan-discussion-paper-remarkable-folder
                                          "/+" "/+")))
           (folder (concat base "/" (tibetan-discussion-paper--doc-name title)))
           (name (tibetan-discussion-paper--doc-name label))
           (dir (make-temp-file "rm-paper-" t))
           (put (lambda (docname retry)
                  ;; RETRY: a function of the stamped name for the
                  ;; first attempt, nil for the last one.
                  (let ((tmp (expand-file-name (concat docname ".pdf") dir)))
                    (copy-file pdf tmp t)
                    (tibetan-discussion-paper--rmapi-session
                     (tibetan-discussion-paper--upload-commands base folder tmp)
                     (lambda (_code out)
                       (pcase (tibetan-discussion-paper--put-result out docname)
                         ('ok
                          (ignore-errors (delete-directory dir t))
                          (message "reMarkable: %s/%s" folder docname))
                         ((and 'exists (guard (functionp retry)))
                          ;; Name taken: once more with a time stamp —
                          ;; the earlier document stays.
                          (funcall retry (format "%s %s" docname
                                                 (format-time-string "%Y-%m-%d %H%M"))))
                         (_
                          (ignore-errors (delete-directory dir t))
                          (message "reMarkable-Upload fehlgeschlagen (%s): %s — PDF liegt unter %s"
                                   docname
                                   (string-trim (replace-regexp-in-string
                                                 "\\[/[^]]*\\]>[ \t]*" "" out))
                                   pdf)))))))))
      (funcall put name (lambda (stamped) (funcall put stamped nil)))
      t)))

(defun tibetan-discussion-paper-upload-many (items)
  "Upload ITEMS ((PDF TITLE LABEL) …) in ONE rmapi session (one token):
every folder once, then one put per item.  Names as in `--upload';
no time-stamp retry — an existing name is reported.  Returns the
session's command list, or nil without rmapi."
  (when (executable-find "rmapi")
    (let* ((base (concat "/" (string-trim tibetan-discussion-paper-remarkable-folder
                                          "/+" "/+")))
           (dir (make-temp-file "rm-papers-" t))
           (folders '()) (puts '()))
      (dolist (it items)
        (pcase-let ((`(,pdf ,title ,label) it))
          (let* ((folder (concat base "/" (tibetan-discussion-paper--doc-name title)))
                 (sub (expand-file-name (tibetan-discussion-paper--doc-name title) dir))
                 (tmp (expand-file-name
                       (concat (tibetan-discussion-paper--doc-name label) ".pdf") sub)))
            (make-directory sub t)
            (copy-file pdf tmp t)
            (unless (member folder folders) (push folder folders))
            (push (list "put" tmp folder) puts))))
      (let ((commands (append (list (list "mkdir" base))
                              (mapcar (lambda (f) (list "mkdir" f)) (nreverse folders))
                              (nreverse puts))))
        (tibetan-discussion-paper--rmapi-session
         commands
         (lambda (_code out)
           (ignore-errors (delete-directory dir t))
           (let ((n (cl-count-if (lambda (l) (string-match-p "\\`uploading:" l))
                                 (split-string out "\n")))
                 (bad (cl-count-if (lambda (l) (string-match-p "Error\\|failed" l))
                                   (split-string out "\n"))))
             (message "reMarkable: %d von %d Papieren hochgeladen%s"
                      (- n bad) (length items)
                      (if (> bad 0) (format " — %d Fehler: %s" bad
                                            (string-trim out))
                        "")))))
        commands))))

(defun tibetan-discussion-paper--generated-buffer-p ()
  "Non-nil when the current buffer is a generated discussion paper."
  (save-excursion
    (goto-char (point-min))
    (looking-at-p (regexp-quote tibetan-discussion-paper-generated-marker))))

(defun tibetan-discussion-paper--title-and-label (org)
  "(TITLE . LABEL) of the generated paper ORG, from its `#+TITLE:
<title> — <label>' line."
  (with-temp-buffer
    (insert-file-contents org nil 0 4096)
    (goto-char (point-min))
    (if (re-search-forward "^#\\+TITLE:[ \t]*\\(.*?\\) — \\(.+\\)$" nil t)
        (cons (match-string 1) (match-string 2))
      (cons (file-name-base org) (file-name-base org)))))

(defun tibetan-discussion-paper--export-and-upload (org &optional no-open)
  "Export ORG to PDF, open it (unless NO-OPEN), upload it when
configured (folder = the work's title, document = the scope label);
return the PDF."
  (let ((pdf (tibetan-handout-export-pdf org))
        (tl (tibetan-discussion-paper--title-and-label org)))
    (unless no-open (org-open-file pdf))
    (if tibetan-discussion-paper-upload
        (tibetan-discussion-paper--upload pdf (car tl) (cdr tl))
      (message "Diskussionspapier: %s" (file-name-nondirectory pdf)))
    pdf))

;; ============================================================================
;; Auto paper after C-c u G (Carsten 20.10.: „C-c u D kann gleich an
;; C-c u G mit angehängt werden")
;; ============================================================================

(defcustom tibetan-discussion-paper-auto t
  "When non-nil, C-c u G ends with the discussion paper: every
sentence of the fetched scope gets its one-sentence paper (\"Satz N\")
— at once when nothing had to be requested, otherwise when its last
expected part (Claude, discussion, Sanskrit comparison) has landed.
Built, exported and uploaded without opening the PDF; a paper whose
content did not change is not uploaded again."
  :type 'boolean
  :group 'tibetan-cat)

(defvar tibetan-discussion-paper--pending (make-hash-table :test #'equal)
  "Cascade files (truenames) whose paper waits for a landing → their
one-sentence scope.")

(defun tibetan-discussion-paper--sentence-scope (source-file sent-num)
  "The one-sentence scope of SENT-NUM in SOURCE-FILE."
  (list :source source-file :sent-nums (list sent-num)
        :label (format "Satz %d" sent-num)))

(defun tibetan-discussion-paper--complete-p (file)
  "Non-nil when the cascade sentence FILE has everything its paper
shows: the translation; the discussion, unless no reference
translation asks for one; the Sanskrit comparison, unless no parallel
Section asks for one."
  (and file (file-exists-p file)
       (tibetan-cascade--clean-slot-text
        (plist-get (tibetan-analysis--read-claude-sections file) :translation))
       (or (tibetan-discussion--present-p file)
           (null (tibetan-discussion--references file)))
       (or (tibetan-sanskrit-comparison--present-p file)
           (not (tibetan-sanskrit-comparison--ready-p
                 (tibetan-sanskrit-comparison--inputs file))))
       t))

(defun tibetan-discussion-paper-auto-build (scope &optional date)
  "Build, export and upload the paper of SCOPE without opening it —
unless the generated .org would be unchanged (dates aside), then
nothing happens and nil is returned.  Returns the PDF otherwise."
  (let* ((out (tibetan-discussion-paper--output-file scope))
         (text (tibetan-discussion-paper--render-scope
                scope (or date (format-time-string "%Y-%m-%d")))))
    (tibetan-discussion-paper--guard-target out)
    (if (tibetan-discussion-paper--unchanged-p out text)
        (progn (message "Diskussionspapier %s unverändert — nicht hochgeladen"
                        (plist-get scope :label))
               nil)
      (make-directory (file-name-directory out) t)
      (with-temp-file out (insert text))
      (tibetan-discussion-paper--export-and-upload out t))))

(defun tibetan-discussion-paper--after-fetch (source-file sentences folder requested)
  "Hook for `tibetan-cascade-fetch-done-functions': the paper of every
sentence that needed no request is built now; the others are
remembered for `--maybe-build'."
  (when tibetan-discussion-paper-auto
    (let ((requested (mapcar #'file-truename requested)))
      (dolist (s sentences)
        (let* ((n (plist-get s :sent-num))
               (file (tibetan-sentence--filepath n folder source-file))
               (scope (tibetan-discussion-paper--sentence-scope source-file n)))
          (if (member (file-truename file) requested)
              (puthash (file-truename file) scope tibetan-discussion-paper--pending)
            (condition-case err
                (tibetan-discussion-paper-auto-build scope)
              (error (message "Diskussionspapier Satz %d übersprungen: %s"
                              n (error-message-string err))))))))))

(defun tibetan-discussion-paper--maybe-build (file)
  "Landing hook: when FILE's paper is pending and FILE is complete,
build it once and forget it."
  (when (and tibetan-discussion-paper-auto file)
    (let* ((key (file-truename file))
           (scope (gethash key tibetan-discussion-paper--pending)))
      (when (and scope (tibetan-discussion-paper--complete-p file))
        (remhash key tibetan-discussion-paper--pending)
        (condition-case err
            (tibetan-discussion-paper-auto-build scope)
          (error (message "Diskussionspapier %s übersprungen: %s"
                          (plist-get scope :label) (error-message-string err))))))))

(add-hook 'tibetan-cascade-fetch-done-functions #'tibetan-discussion-paper--after-fetch)
(add-hook 'tibetan-cascade-after-land-functions #'tibetan-discussion-paper--maybe-build)
(add-hook 'tibetan-dharmamitra-translation-after-write-functions
          #'tibetan-discussion-paper--maybe-build)
(add-hook 'tibetan-discussion-after-land-functions #'tibetan-discussion-paper--maybe-build)
(add-hook 'tibetan-sanskrit-comparison-after-land-functions
          #'tibetan-discussion-paper--maybe-build)

;;;###autoload
(defun tibetan-discussion-paper (&optional org-only)
  "Discussion paper for the reMarkable for the scope at point (C-c u D).
In a cascade source: the sentence at point, or every sentence under
the heading at point; in a sent-NNN analysis buffer: that sentence.
Writes `handouts/<short>-disk-….org' beside the source, exports it
to PDF, opens the PDF and uploads it to the reMarkable
\(`tibetan-discussion-paper-upload').  With ORG-ONLY (C-u): only the
.org, opened for editing.  INSIDE a generated paper the buffer is
saved, exported and uploaded as it is.  No API call."
  (interactive "P")
  (if (and (buffer-file-name) (tibetan-discussion-paper--generated-buffer-p))
      (progn
        (save-buffer)
        (tibetan-discussion-paper--export-and-upload (buffer-file-name)))
    (let ((scope (tibetan-cascade--scope-at-point)))
      (when (and (> (length (plist-get scope :sent-nums)) 50)
                 (not (y-or-n-p (format "Diskussionspapier über %d Sätze erzeugen? "
                                        (length (plist-get scope :sent-nums))))))
        (user-error "Abgebrochen"))
      (let ((org (tibetan-discussion-paper-build scope)))
        (if org-only
            (progn (find-file org)
                   (message "Diskussionspapier (org): %s" (file-name-nondirectory org)))
          (tibetan-discussion-paper--export-and-upload org))))))

(provide 'tibetan-discussion-paper)
;;; tibetan-discussion-paper.el ends here
